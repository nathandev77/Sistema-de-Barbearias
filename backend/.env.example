# ═══════════════════════════════════════════════════════════════════════════════
# SAAS BARBER — ENVIRONMENT SETTINGS (BACKEND)
# ═══════════════════════════════════════════════════════════════════════════════

# Server Port and Environment
PORT=3001
NODE_ENV=development # development | production

# Frontend URL (for CORS and links in emails)
FRONTEND_URL="http://localhost:5173"
CORS_ORIGIN="http://localhost:5173,https://controlbarber.online,https://www.controlbarber.online"

# PostgreSQL Database (Supabase / Neon / Local)
# Connection Pooling (Pooler - Port 6543 or 5432)
DATABASE_URL="postgresql://postgres.[ref]:[password]@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct Connection (For Prisma migrations - Port 5432)
DIRECT_URL="postgresql://postgres.[ref]:[password]@aws-0-sa-east-1.pooler.supabase.com:5432/postgres"

# JWT Authentication (Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_SECRET="generate_a_long_random_jwt_secret_with_at_least_64_characters"

# SaaS Admin Master Keys (/saas-admin)
# Supports one or multiple comma-separated keys (one for each authorized administrator)
# Generate secure keys by running: node scripts/generate_keys.mjs
SUPER_ADMIN_KEYS="sk_owner_yourkeyhere,sk_admin_secondarykey"

# SMTP Server for Sending Emails (Resend, SendGrid, Gmail or Brevo)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
SMTP_FROM="Barber Control <no-reply@controlbarber.online>"

# Evolution API (WhatsApp Bot / N8N Integration)
EVOLUTION_URL="https://your-evolution-api.easypanel.host"
EVOLUTION_KEY="your_evolution_api_key"

# Redis (Optional - for rate limiting and OTP in distributed memory)
# REDIS_URL="redis://localhost:6379"
