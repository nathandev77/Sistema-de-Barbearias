# ═══════════════════════════════════════════════════════════════════════════════
# SAAS BARBER — CONFIGURAÇÕES DE AMBIENTE (BACKEND)
# ═══════════════════════════════════════════════════════════════════════════════

# Porta do Servidor e Ambiente
PORT=3001
NODE_ENV=development # development | production

# URL do Frontend (para CORS e links em e-mails)
FRONTEND_URL="http://localhost:5173"
CORS_ORIGIN="http://localhost:5173,https://controlbarber.online,https://www.controlbarber.online"

# Banco de Dados PostgreSQL (Supabase / Neon / Local)
# Connection Pooling (Pooler - Porta 6543 ou 5432)
DATABASE_URL="postgresql://postgres.[ref]:[password]@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Conexão Direta (Para migrações do Prisma - Porta 5432)
DIRECT_URL="postgresql://postgres.[ref]:[password]@aws-0-sa-east-1.pooler.supabase.com:5432/postgres"

# Autenticação JWT (Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_SECRET="gere_um_jwt_secret_longo_e_aleatorio_com_pelo_menos_64_caracteres"

# Chaves Mestras do SaaS Admin (/saas-admin)
# Suporta uma ou múltiplas chaves separadas por vírgula (uma para cada administrador autorizado)
# Gere chaves seguras rodando: node scripts/generate_keys.mjs
SUPER_ADMIN_KEYS="sk_owner_suachaveaqui,sk_admin_chaveauxiliar"

# Servidor SMTP para Envio de E-mails (Resend, SendGrid, Gmail ou Brevo)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="seu-email@gmail.com"
SMTP_PASS="sua-senha-de-app"
SMTP_FROM="Barber Control <nao-responda@controlbarber.online>"

# Evolution API (WhatsApp Bot / N8N Integration)
EVOLUTION_URL="https://seu-evolution-api.easypanel.host"
EVOLUTION_KEY="sua_chave_evolution_api"

# Redis (Opcional - para rate limiting e OTP em memória distribuída)
# REDIS_URL="redis://localhost:6379"
